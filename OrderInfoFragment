        <div style="margin-top:8px;">
            <a href="/blocked-zones-ui?user_id={{ user_id }}&lat={{ lat }}&lon={{ lon }}" style="color:white; text-decoration:underline;">🗺️ Zonas Bloqueadas</a>
        </div>
    </div>

    <div class="container">
        <form id="configForm">
            <input type="hidden" id="user_id" value="{{ user_id }}">
            
            <div class="card">
                <div class="card-header">📏 Distancias (Km)</div>
                <div class="form-grid three">
                    <div><label>Max Recojo</label><input type="number" step="0.1" id="max_pickup_dist" value="{{ config.max_pickup_dist }}"></div>
                    <div><label>Min Viaje</label><input type="number" step="0.1" id="min_dest_dist" value="{{ config.min_dest_dist }}"></div>
                    <div><label>Max Viaje</label><input type="number" step="0.1" id="max_dest_dist" value="{{ config.max_dest_dist }}"></div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">💰 Precios</div>
                <div class="form-grid">
                    <div><label>Mínimo</label><input type="number" id="min_price" value="{{ config.min_price }}"></div>
                    <div><label>Máximo</label><input type="number" id="max_price" value="{{ config.max_price }}"></div>
                </div>
                <div style="margin-top:10px;"><label>Base por Km</label><input type="number" id="base_price_km" value="{{ config.base_price_km }}"></div>
            </div>

            <div class="card">
                <div class="card-header">📊 Tarifas Dinámicas</div>
                <div id="tiersContainer"></div>
                <button type="button" class="btn-add" onclick="addTier()">+ Añadir Tramo</button>
            </div>

            <div class="card">
                <div class="card-header">⚙️ Reglas</div>
                <div class="form-grid">
                    <div><label>Min Rating</label><input type="number" step="0.1" id="min_rating" value="{{ config.min_rating }}"></div>
                    <div><label>Min Viajes</label><input type="number" id="min_rides" value="{{ config.min_rides }}"></div>
                </div>
                
                <div class="toggle-row">
                    <span>Rechazar Tags/Notas</span>
                    <label class="switch"><input type="checkbox" id="reject_tags" onchange="toggleBannedWords()" {% if config.reject_tags %}checked{% endif %}><span class="slider"></span></label>
                </div>
                
                <div id="bannedWordsContainer" style="display: none; padding: 10px; background: #fffbe6; border: 1px solid #ffe58f; border-radius: 8px; margin-top: 10px;">
                    <label style="color: #d48806;">Palabras Bloqueadas (separadas por coma)</label>
                    <small style="display:block; color: #888; margin-bottom:5px;">Si se deja vacío, bloquea TODO si hay tags.</small>
                    <input type="text" id="banned_words" placeholder="Ej: bebe, mascota, tarjeta">
                </div>

                <div class="toggle-row">
                    <span>Aceptar Paradas</span>
                    <label class="switch"><input type="checkbox" id="accept_stops" {% if config.accept_stops %}checked{% endif %}><span class="slider"></span></label>
                </div>
                <div class="toggle-row">
                    <span>Aceptar Aeropuerto</span>
                    <label class="switch"><input type="checkbox" id="accept_airport" {% if config.accept_airport %}checked{% endif %}><span class="slider"></span></label>
                </div>
                
                <div style="margin-top:10px;"><label>Max Repeticiones</label><input type="number" id="max_repeats" value="{{ config.max_repeats }}"></div>
                <div style="margin-top:10px;"><label>Tiempo Recogida (min)</label><input type="number" id="pickup_time_minutes" value="{{ config.pickup_time_minutes }}"></div>
            </div>
        </form>
    </div>

    <button type="button" class="btn-save" onclick="save()">GUARDAR CAMBIOS</button>

    <script>
        let tiers = {{ config.fare_tiers | tojson }};
        let bannedWords = {{ config.banned_words | tojson }};

        function toggleBannedWords() {
            const isChecked = document.getElementById('reject_tags').checked;
            document.getElementById('bannedWordsContainer').style.display = isChecked ? 'block' : 'none';
        }

        // Initialize UI
        document.getElementById('banned_words').value = (bannedWords || []).join(', ');
        toggleBannedWords(); // Set initial state check

        function renderTiers() {
            const c = document.getElementById('tiersContainer');
            c.innerHTML = '';
            tiers.forEach((t, i) => {
                c.innerHTML += `
                <div class="tier-item">
                    <button type="button" class="btn-remove" onclick="removeTier(${i})">×</button>
                    <div class="form-grid three">
                        <div><label>De (km)</label><input type="number" value="${t.min_dist}" onchange="updateTier(${i},'min_dist',this.value)"></div>
                        <div><label>A (km)</label><input type="number" value="${t.max_dist}" onchange="updateTier(${i},'max_dist',this.value)"></div>
                        <div><label>Precio/km</label><input type="number" value="${t.rate}" onchange="updateTier(${i},'rate',this.value)"></div>
                    </div>
                </div>`;
            });
        }
        function addTier() { tiers.push({min_dist:0, max_dist:10, rate:3000}); renderTiers(); }
        function removeTier(i) { tiers.splice(i, 1); renderTiers(); }
        function updateTier(i, k, v) { tiers[i][k] = parseFloat(v); }

        function save() {
            const btn = document.querySelector('.btn-save');
            const originalText = btn.innerText;
            btn.innerText = 'GUARDANDO...';
            btn.style.opacity = '0.7';

            // Parse banned words
            const rawWords = document.getElementById('banned_words').value;
            const wordsList = rawWords.split(',').map(s => s.trim()).filter(s => s.length > 0);

            const data = {
                user_id: document.getElementById('user_id').value,
                max_pickup_dist: parseFloat(document.getElementById('max_pickup_dist').value)||0,
                min_dest_dist: parseFloat(document.getElementById('min_dest_dist').value)||0,
                max_dest_dist: parseFloat(document.getElementById('max_dest_dist').value)||0,
                min_price: parseFloat(document.getElementById('min_price').value)||0,
                max_price: parseFloat(document.getElementById('max_price').value)||0,
                base_price_km: parseFloat(document.getElementById('base_price_km').value)||0,
                min_rating: parseFloat(document.getElementById('min_rating').value)||0,
                min_rides: parseFloat(document.getElementById('min_rides').value)||0,
                max_repeats: parseInt(document.getElementById('max_repeats').value)||0,
                pickup_time_minutes: parseInt(document.getElementById('pickup_time_minutes').value)||5,
                reject_tags: document.getElementById('reject_tags').checked,
                accept_stops: document.getElementById('accept_stops').checked,
                accept_airport: document.getElementById('accept_airport').checked,
                fare_tiers: tiers,
                banned_words: wordsList
            };
            
            fetch('/config', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(d => {
                btn.innerText = '¡GUARDADO!';
                btn.style.background = 'var(--success)';
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.style.background = 'var(--primary)';
                    btn.style.opacity = '1';
                }, 1500);
            })
            .catch(e => {
                alert('Error al guardar: ' + e);
                btn.innerText = originalText;
                btn.style.opacity = '1';
            });
        }

        renderTiers();
    </script>
</body>
</html>
"""

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 10000))
    app.run(host='0.0.0.0', port=port)
